# Clerk — aplicación app_3Kz4XeP3BRa9yZTTeoDASlV8dNq
# Copia cada clave al archivo que se indica. No subas los valores reales.
# El login queda apagado hasta que estas claves existan.
# La clave publicable empieza por pk_. La secreta empieza por sk_ y no va al navegador.

# frontend/.env
VITE_CLERK_PUBLISHABLE_KEY=

# backend/pizza_simulator/.env
CLERK_SECRET_KEY=

# Quién puede cambiar el modelo del chat cuando Clerk está activo.
# La comparación no distingue mayúsculas. El navegador no recibe esta dirección.
SUPER_ADMIN_EMAIL=

# Ollama en el Mac, con el backend dentro de Docker:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat por OpenRouter, si ese archivo todavía no las tiene:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.7
